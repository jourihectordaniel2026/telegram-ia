# -----------------------------------------------------------
# Copiá este archivo como ".env" y completá con tus claves.
#   copy .env.example .env     (Windows)
#   cp .env.example .env       (Mac/Linux)
#
# NUNCA subas el archivo .env a git. El .gitignore ya lo excluye.
# -----------------------------------------------------------

# Token del bot de Telegram (lo da @BotFather con /newbot)
TELEGRAM_BOT_TOKEN=

# --- Proveedor de IA (elegí uno o los dos) -------------------

# Opcion A: API oficial de Anthropic (console.anthropic.com -> API keys)
ANTHROPIC_API_KEY=

# Opcion B: OpenRouter (openrouter.ai -> Keys). Si hay clave aca, el bot
# la usa en vez de Anthropic.
OPENROUTER_API_KEY=

# auto = usa OpenRouter si hay clave, si no Anthropic.
# Fuerza uno con: PROVEEDOR=anthropic   o   PROVEEDOR=openrouter
PROVEEDOR=auto

# Modelo en la API oficial de Anthropic
CLAUDE_MODEL=claude-sonnet-5-5

# Modelo en OpenRouter (el slug lleva el prefijo del laboratorio)
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

# --- Opcionales -----------------------------------------------
#MAX_TOKENS=1024
#MAX_HISTORIAL=20
#SYSTEM_PROMPT=Sos el asistente de una libreria universitaria. Respondes en espanol.

# POSTGRES_PASSWORD=libreria-dev
